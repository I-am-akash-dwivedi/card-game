{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "card-game-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GameRoom",
        "class_name": "GameRoom"
      }
    ]
  },
  // `new_sqlite_classes` (not `new_classes`) is required for the Workers free
  // plan — only SQLite-backed Durable Objects are available there.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
