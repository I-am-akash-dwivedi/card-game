  },
  "dependencies": {
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.120.0"
  }
}
